{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tier 0 exact human-mouse variant correspondence row",
  "description": "Exchange contract for collaborator-supplied exact human-mouse variant correspondences. TSV column order is defined by data/external/tier0_exact_variant.template.tsv.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier_id",
    "connection_basis",
    "match_level",
    "exact_match_definition",
    "human_gene",
    "human_variant_id",
    "human_assembly",
    "mouse_gene",
    "mouse_variant_id",
    "mouse_assembly",
    "ortholog_source",
    "cross_species_alignment_source",
    "alignment_version",
    "allele_orientation",
    "reciprocal_mapping",
    "qc_status",
    "source_dataset",
    "source_version",
    "source_record_id",
    "source_sha256"
  ],
  "properties": {
    "tier_id": { "const": "tier0" },
    "connection_basis": { "const": "exact_variant_correspondence" },
    "match_level": {
      "enum": ["genomic_reciprocal_exact", "coding_exact", "protein_exact"]
    },
    "exact_match_definition": { "type": "string", "minLength": 1 },
    "human_gene": { "type": "string", "minLength": 1 },
    "human_ncbi_gene_id": { "type": "string" },
    "human_hgnc_id": { "type": "string" },
    "human_variant_id": { "type": "string", "minLength": 1 },
    "human_assembly": { "type": "string", "minLength": 1 },
    "human_chromosome": { "type": "string" },
    "human_position": { "type": "string" },
    "human_reference_allele": { "type": "string" },
    "human_alternate_allele": { "type": "string" },
    "human_transcript": { "type": "string" },
    "human_hgvs_c": { "type": "string" },
    "human_hgvs_p": { "type": "string" },
    "mouse_gene": { "type": "string", "minLength": 1 },
    "mouse_ncbi_gene_id": { "type": "string" },
    "mgi_marker_id": { "type": "string" },
    "mouse_variant_id": { "type": "string", "minLength": 1 },
    "mouse_assembly": { "type": "string", "minLength": 1 },
    "mouse_chromosome": { "type": "string" },
    "mouse_position": { "type": "string" },
    "mouse_reference_allele": { "type": "string" },
    "mouse_alternate_allele": { "type": "string" },
    "mouse_transcript": { "type": "string" },
    "mouse_hgvs_c": { "type": "string" },
    "mouse_hgvs_p": { "type": "string" },
    "ortholog_source": { "type": "string", "minLength": 1 },
    "cross_species_alignment_source": { "type": "string", "minLength": 1 },
    "alignment_version": { "type": "string", "minLength": 1 },
    "allele_orientation": { "enum": ["forward", "reverse_complement"] },
    "reciprocal_mapping": { "enum": [0, 1] },
    "qc_status": { "enum": ["pending", "passed", "rejected"] },
    "source_dataset": { "type": "string", "minLength": 1 },
    "source_version": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "license": { "type": "string" },
    "contributor": { "type": "string" },
    "notes": { "type": "string" }
  }
}
